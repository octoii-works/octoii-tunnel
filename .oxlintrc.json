{
	"$schema": "./node_modules/oxlint/configuration_schema.json",
	"plugins": ["typescript", "unicorn", "oxc", "import"],
	// Correctness is on whole; every other rule is chosen one by one below. Rules are only "error" or "off".
	"categories": { "correctness": "error" },
	// The repository's own rules: oxlint-plugin-tunnel.
	"jsPlugins": ["./oxlint-plugin-tunnel/index.ts"],
	"rules": {
		// ---- Correctness ----
		// The type checker already checks every member read from a namespace import, computed ones included.
		"import/namespace": "off",
		// `for (const listener of [...this.listeners])` copies on purpose: a listener may unsubscribe, and ending a
		// handle removes it from the set being walked.
		"unicorn/no-useless-spread": "off",
		// Suspicious rules that catch real mistakes here: code that does not do what it seems to, imports that name the
		// wrong thing, and comparisons, templates and constraints that say nothing.
		"block-scoped-var": "error",
		"no-extend-native": "error",
		"no-extra-bind": "error",
		"no-implied-eval": "error",
		"no-new": "error",
		"no-unexpected-multiline": "error",
		"no-unneeded-ternary": "error",
		"no-useless-concat": "error",
		"import/no-absolute-path": "error",
		"import/no-empty-named-blocks": "error",
		"import/no-named-as-default": "error",
		"import/no-named-as-default-member": "error",
		"import/no-self-import": "error",
		"oxc/approx-constant": "error",
		"oxc/misrefactored-assign-op": "error",
		"oxc/no-async-endpoint-handlers": "error",
		"oxc/no-this-in-exported-function": "error",
		"typescript/no-confusing-non-null-assertion": "error",
		"typescript/no-generated-empty-object-type": "error",
		"typescript/no-unnecessary-template-expression": "error",
		"typescript/no-unnecessary-type-constraint": "error",
		"typescript/no-unsafe-enum-comparison": "error",
		"unicorn/no-accessor-recursion": "error",
		"unicorn/no-array-fill-with-reference-type": "error",
		"unicorn/no-confusing-array-with": "error",
		"unicorn/no-instanceof-builtins": "error",
		"unicorn/require-module-specifiers": "error",
		// Errors handled explicitly: a new error keeps the one it replaces.
		"preserve-caught-error": "error",

		// ---- Type-aware ----
		// A durable runtime loses writes and errors to a promise nobody awaits.
		"typescript/no-floating-promises": "error",
		"typescript/no-misused-promises": "error",
		"typescript/await-thenable": "error",
		// No escape from the type checker.
		"typescript/no-explicit-any": "error",
		"typescript/no-non-null-assertion": "error",
		"typescript/no-unnecessary-type-assertion": "error",
		// Code that says less than it seems to.
		"typescript/require-array-sort-compare": "error",
		"typescript/no-meaningless-void-operator": "error",
		"typescript/no-duplicate-type-constituents": "error",
		"typescript/no-redundant-type-constituents": "error",
		"typescript/no-implied-eval": "error",
		// Type-aware rules that only flag what is meant here: function-valued members such as `clock.now` passed on,
		// a deliberate `String(value)`, and spreading strings into characters.
		"typescript/unbound-method": "off",
		"typescript/no-base-to-string": "off",
		"typescript/restrict-template-expressions": "off",
		"typescript/no-misused-spread": "off",

		// ---- Style ----
		// Names, flags, comments and suppressions as the repository asks: the device-side process is the connector, every
		// export is documented, a module's constants are UPPER_CASE, and docs and comments name no other project.
		"tunnel/connector-not-agent": "error",
		"tunnel/require-export-doc": "error",
		"tunnel/upper-case-constants": "error",
		"tunnel/no-boolean-parameters": "error",
		"tunnel/no-other-project-names": "error",
		"tunnel/disable-needs-reason": "error",
		// Every `as` is a claim the checker cannot verify: outside tests, each says why it holds in a `SAFETY:` comment.
		// Type evidence is kept, not thrown away and claimed back.
		"tunnel/require-safety-comment-for-type-assertion": "error",
		"tunnel/no-chained-type-assertions": "error",
		"tunnel/no-widen-then-assert": "error",
		// Small functions: limits the large majority of the code meets, so they catch outliers, not ordinary code.
		"max-lines-per-function": ["error", { "max": 120, "skipBlankLines": true, "skipComments": true }],
		"complexity": ["error", { "max": 30 }],
		"max-params": ["error", { "max": 6 }],
		"max-depth": ["error", { "max": 5 }],

		// ---- Architecture boundaries ----
		// Modules form layers: a cycle means a shared piece lives in the wrong module. Type imports are erased, so only
		// value imports count.
		"import/no-cycle": ["error", { "ignoreTypes": true }],

		// ---- Tests ----
		// A test replaces a dependency through a real seam, never by mocking its module, and says why it skips.
		"tunnel/no-module-mocking": "error",
		"tunnel/no-unexplained-skips": "error"
	},
	"overrides": [
		{
			// bun:test types `expect(promise).rejects` as returning nothing, yet it must be awaited; the relay's suite is test code.
			"files": ["**/test/**", "packages/relay/src/testing/**"],
			"rules": { "typescript/await-thenable": "off", "tunnel/require-safety-comment-for-type-assertion": "off" }
		},
		{
			// A test file's `describe` callback groups its cases: its length is the number of cases, not one function's size.
			"files": ["**/test/**", "packages/relay/src/testing/**"],
			"rules": { "max-lines-per-function": "off" }
		},
		{
			// The client and the relay core run on the clock, timers and randomness they are given: the client's Platform,
			// the relay's host.
			"files": ["packages/tunnel/src/**/*.ts", "packages/relay/src/**/*.ts"],
			"rules": { "tunnel/no-host-platform": "error" }
		},
		{
			// What a platform gives: the web standards' own, Bun's, and a Durable Object host's.
			"files": ["packages/tunnel/src/web.ts", "packages/tunnel/src/bun/**", "packages/relay/src/bun/**", "packages/relay/src/worker/**", "packages/relay/src/testing/**"],
			"rules": { "tunnel/no-host-platform": "off" }
		},
		{
			// The client runs on Hermes, which lacks these: the protocol has UTF-8 and base64url of its own.
			"files": ["packages/tunnel/src/**/*.ts"],
			"rules": {
				"no-restricted-globals": [
					"error",
					{ "name": "TextDecoder", "message": "Hermes has no TextDecoder; use decodeUtf8 from the protocol." },
					{ "name": "TextEncoder", "message": "Use encodeUtf8 from the protocol, which runs everywhere." },
					{ "name": "btoa", "message": "Hermes may lack btoa; use encodeBase64Url from the protocol." },
					{ "name": "atob", "message": "Hermes may lack atob; use decodeBase64Url from the protocol." }
				]
			}
		}
	]
}
